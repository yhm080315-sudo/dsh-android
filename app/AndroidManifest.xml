<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.android"
    android:versionCode="10021"
    android:versionName="1.0.21+dsh.0.2.1-rc.2">

    <!-- targetSdk 28 keeps the pre-Android-10 exec-from-app-data policy that the
         bundled runtime depends on: the harness runs ELF binaries out of the
         app's private directory, exactly like Termux does from its prefix. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a declared type plus its matching permission for
         foreground services; the node process is kept alive as a data-sync job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Declared by Shizuku's provider library. It lets the Shizuku manager hand
         this app the privileged binder after the user authorises it; the app
         itself does not need it for anything else. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Shared-storage access so the harness can read and write the phone's files.
         READ/WRITE_EXTERNAL_STORAGE are the runtime permissions (granted in-app);
         MANAGE_EXTERNAL_STORAGE is the "All files access" special permission the
         user toggles in Settings on Android 11+. requestLegacyExternalStorage
         keeps the pre-scoped model working where the platform still honours it. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="DeepSeek Harness"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="DeepSeek Harness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shizuku's binder handshake. The manager queries this provider (it holds
             INTERACT_ACROSS_USERS_FULL) and delivers the adb-shell binder here.
             Without Shizuku installed the provider simply never receives a binder:
             Shizuku.pingBinder() stays false and the app falls back to su/none. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.dsh.android.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <provider
            android:name=".FileBridge"
            android:authorities="com.dsh.android.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.dsh.android.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Shizuku v13 protocol marker (usually merged from the provider AAR;
             this build has no AAR merging, so it is declared here). -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
        <service
            android:name=".NodeServer"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Zero-install input channel. The system binds this only after the user
             turns it on in Settings -> Accessibility; until then the component is
             just a declaration and every call answers NO_PRIVILEGE. It serves
             tap/swipe/text/UI-reading only; screenshots need MediaProjection.
             (XML comments cannot contain a double hyphen, so no dashes above.) -->
        <service
            android:name=".DshAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
